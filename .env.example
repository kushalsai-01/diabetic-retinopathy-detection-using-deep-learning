# Diabetic Retinopathy Detection — Environment Variables
# Copy this file to .env and fill in values before running.

# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://dr_user:dr_password@db:5432/dr_db

# Path to the trained model checkpoint
MODEL_CHECKPOINT_PATH=model/checkpoints/best_model.pth

# Compute device: 'cuda' or 'cpu'
DEVICE=cpu

# Directories (created automatically on startup if missing)
UPLOAD_DIR=backend/uploads
HEATMAP_DIR=inference/heatmaps
REPORT_DIR=backend/reports
